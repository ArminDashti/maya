# Copy to .env (never commit .env)

# Host port published by Open WebUI (container listens on 8080)
PUBLISH_PORT=3080

# Brand (Open WebUI license appends " (Open WebUI)" when not the default name)
WEBUI_NAME=Maya

# OpenAI-compatible provider = cursor-sdk-to-openai (Admin → Connections).
# Must use Docker DNS from maya-openwebui — NOT localhost.
# Host publish for browsers/tools outside Docker: http://127.0.0.1:8173/v1
# Note: cursor-headless-cli-to-api.local is NOT OpenAI-compatible (/api/v1/runs).
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=http://cursor-sdk-to-openai-api-1:8140/v1
OPENAI_API_KEY=local
OPENAI_API_CONFIGS={"0":{"enable":true,"tags":[{"name":"cursor-sdk-to-openai"}],"connection_type":"external","auth_type":"bearer","prefix_id":"","model_ids":["gemini-3.8-flash"]}}

# Dual Ollama: local (host) + LAN server. Prefixes applied at runtime by sync-maya.ps1.
ENABLE_OLLAMA_API=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URLS=http://host.docker.internal:11434;http://10.10.16.118:11434

# Public URL for links/callbacks. Canonical http://maya.local; /maya bookmarks 302 there.
WEBUI_URL=http://maya.local
WEBUI_ADMIN_EMAIL=armin@local
WEBUI_ADMIN_NAME=armin
WEBUI_ADMIN_PASSWORD=123456
# Default = Cursor-Gemini-3.8 (see .armin/rag/sync-maya.ps1)
DEFAULT_MODELS=cursor-gemini-3.8
WEBUI_SECRET_KEY=change-me-maya-local
