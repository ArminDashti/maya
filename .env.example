# Copy to .env (never commit .env)

# Host port published by Open WebUI (container listens on 8080)
PUBLISH_PORT=3080

# OpenAI-compatible provider = cursor-sdk-to-openai (Admin → Connections).
# Must use Docker DNS from maya-open-webui — NOT localhost (that is the container itself).
# Host publish for browsers/tools outside Docker: http://127.0.0.1:8173/v1
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=http://cursor-sdk-to-openai-api-1:8140/v1
# Use AUTH_KEY from cursor-sdk-to-openai-api/.env when set; otherwise "local"
OPENAI_API_KEY=local
# enable=true lists Cursor models for all users (grant public read via sync / Admin → Models).
OPENAI_API_CONFIGS={"0":{"enable":true,"tags":[{"name":"cursor-sdk-to-openai"}],"connection_type":"external","auth_type":"bearer","prefix_id":"","model_ids":[]}}

# Host Ollama (Windows). Container reaches it via host.docker.internal (extra_hosts).
ENABLE_OLLAMA_API=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
WEBUI_URL=http://10.20.9.59:3080
WEBUI_ADMIN_EMAIL=armin@local
WEBUI_ADMIN_NAME=armin
WEBUI_ADMIN_PASSWORD=dopadopa123
# Default = Cursor-API-Composer only (id erp-reports-65778; see .armin/rag/sync-user-65778-reports.ps1)
DEFAULT_MODELS=erp-reports-65778
WEBUI_SECRET_KEY=change-me-maya-local
