# Copy to .env (never commit .env)

# Host port published by Open WebUI (container listens on 8080)
PUBLISH_PORT=3080

# Brand (Open WebUI license appends " (Open WebUI)" when not the default name)
WEBUI_NAME=Maya

# Providers (Admin -> Connections): OpenRouter + OpenCode Go = exactly 4 models.
#   OpenRouter-Auto             -> openrouter/auto        (chat/completions)
#   OpenCode-Mimo-v2.6-Flash    -> mimo-v2.6-flash        (chat/completions)
#   OpenCode-DeepSeek-4.1-Flash -> deepseek-v4.1-flash    (chat/completions)
#   OpenCode-GPT-6-Luna         -> gpt-6-luna             (Responses API only)
# No keys here: compose reads OPENROUTER_API_KEY / OPENCODE_API_KEY from the
# host environment (Windows user env vars) and builds OPENAI_API_KEYS.
# Base URL triple: OpenRouter, OpenCode Go (chat), OpenCode Go (responses).
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URLS=https://openrouter.ai/api/v1;https://opencode.ai/zen/go/v1;https://opencode.ai/zen/go/v1
# OpenCode Go needs x-opencode-session (stable per conversation; {{CHAT_ID}} is
# substituted per request) and a non-SDK User-Agent. connection 2 = /responses.
OPENAI_API_CONFIGS={"0":{"enable":true,"tags":[{"name":"openrouter"}],"connection_type":"external","auth_type":"bearer","prefix_id":"","model_ids":["openrouter/auto"]},"1":{"enable":true,"tags":[{"name":"opencode-go"}],"connection_type":"external","auth_type":"bearer","prefix_id":"","model_ids":["mimo-v2.6-flash","deepseek-v4.1-flash"],"headers":{"x-opencode-session":"maya-{{CHAT_ID}}","User-Agent":"maya-openwebui/1.0"}},"2":{"enable":true,"tags":[{"name":"opencode-go"}],"connection_type":"external","auth_type":"bearer","prefix_id":"","api_type":"responses","model_ids":["gpt-6-luna"],"headers":{"x-opencode-session":"maya-{{CHAT_ID}}","User-Agent":"maya-openwebui/1.0"}}}

# Ollama: kept for later, disabled so it adds no models to the picker.
ENABLE_OLLAMA_API=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URLS=http://host.docker.internal:11434;http://10.10.16.118:11434

# Vector DB: NOT used for report retrieval any more - the ERP report catalog is
# ranked with BM25 by the global filter (compose mounts
# .armin/rag/generated/reports-access to /app/backend/data/maya-catalog).
# Qdrant stays wired only because Open WebUI requires a valid VECTOR_DB at startup.
VECTOR_DB=qdrant
QDRANT_URI=http://host.docker.internal:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=maya
QDRANT_ON_DISK=false
# Embedding/reranker settings below are inert while no model has a knowledge base
# attached. Persian corpus -> multilingual (not the English all-MiniLM default).
HF_HUB_OFFLINE=1
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Hybrid retrieval + multilingual CrossEncoder rerank (Admin -> Documents can override)
ENABLE_RAG_HYBRID_SEARCH=true
RAG_TOP_K=5
RAG_TOP_K_RERANKER=5
RAG_RELEVANCE_THRESHOLD=0.4
RAG_RERANKING_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Public URL for links/callbacks. Canonical http://maya.local; /maya bookmarks 302 there.
WEBUI_URL=http://maya.local
WEBUI_ADMIN_EMAIL=armin@local
WEBUI_ADMIN_NAME=armin
WEBUI_ADMIN_PASSWORD=123456
# Default = OpenRouter-Auto (see .armin/rag/sync-maya.ps1)
DEFAULT_MODELS=openrouter-auto
WEBUI_SECRET_KEY=change-me-maya-local
