# Copy to .env (never commit .env)

# Host port published by Open WebUI (container listens on 8080)
PUBLISH_PORT=3080

# cursor-sdk-to-openai OpenAI-compatible API (host). Match the live API listen port.
OPENAI_API_BASE_URL=http://host.docker.internal:8140/v1
# Use AUTH_KEY from cursor-sdk-to-openai-api/.env when set; otherwise "local"
OPENAI_API_KEY=local

ENABLE_OLLAMA_API=false
WEBUI_URL=http://pc-armin/maya
WEBUI_ADMIN_EMAIL=armin@local
WEBUI_ADMIN_NAME=armin
WEBUI_ADMIN_PASSWORD=dopadopa123
DEFAULT_MODELS=composer-2.5
WEBUI_SECRET_KEY=change-me-maya-local
